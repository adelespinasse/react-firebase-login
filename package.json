{
  "name": "@aldel/react-firebase-login",
  "version": "3.0.0",
  "description": "React components for Firebase authentication",
  "keywords": [
    "react",
    "firebase",
    "authentication",
    "login",
    "signin",
    "signup"
  ],
  "homepage": "https://github.com/adelespinasse/react-firebase-login",
  "bugs": "https://github.com/adelespinasse/react-firebase-login/issues",
  "author": {
    "name": "Alan deLespinasse",
    "url": "https://aldel.com"
  },
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "firebase emulators:start --only auth,ui & storybook dev -p 6006",
    "demo": "firebase emulators:start --only auth,ui & vite --config vite.config.demo.ts",
    "demo:prod": "npm run build:demo && vite preview --config vite.config.demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "storybook build",
    "build:lib": "tsc && vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "lint": "tsc --noEmit && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier . --write --ignore-unknown",
    "prepack": "npm run build:lib",
    "prepare": "echo DISABLED husky install",
    "prepublishOnly": "echo DISABLED npm run build",
    "test-app": "firebase emulators:exec --only auth,ui ./run-test-app.sh",
    "test-pw": "npx firebase-tools emulators:exec --only auth ./run-playwright-tests.sh",
    "test-pw-ui": "firebase emulators:exec --only auth,ui ./run-playwright-tests-ui.sh",
    "test-report": "playwright show-report",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.54.2",
    "@storybook/addon-actions": "^8.5.3",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.5.3",
    "@storybook/builder-vite": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tailwindcss/vite": "^4.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/coverage-v8": "^3.0.5",
    "clsx": "^2.1.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest-dom": "^5.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^0.11.2",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.14",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "typedoc": "^0.28.9",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "firebase": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-phone-number-input": "^3.4.12",
    "react-social-login-buttons": "^4.1.1"
  }
}
